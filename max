#!/bin/sh
# Run this checkout with isolated development configuration.
set -eu
MAXCLI_SOURCE="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
MAXCLI_CONFIG_DIR="${MAXCLI_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/maxcli-dev}"
export MAXCLI_CONFIG_DIR
exec "${MAXCLI_PYTHON:-python3}" "$MAXCLI_SOURCE/main.py" "$@"
